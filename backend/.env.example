# Copy this file to ".env" (same folder as main.py) and fill in your values.
# Never commit the real .env -- add it to .gitignore.

# ---- master switches -------------------------------------------------------
EMAIL_ENABLED=true
# While developing, set this to true: emails are printed to the terminal
# instead of being sent, so you can test the whole flow with no SMTP account.
EMAIL_CONSOLE_ONLY=true

# ---- SMTP ------------------------------------------------------------------
# Gmail: generate an App Password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification on). Your normal Gmail password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=yourname@gmail.com
SMTP_FROM_NAME=Student Marketplace
SMTP_TIMEOUT=20

# Port 465 instead? Use:
# SMTP_PORT=465
# SMTP_SSL=true
# SMTP_STARTTLS=false

# ---- app -------------------------------------------------------------------
APP_NAME=HyperLocal Student Marketplace
MARKETPLACE_DB=marketplace.db
# Max shops emailed when one student posts a request (fan-out guard)
EMAIL_MAX_FANOUT=50
