# Copy this file to ".env" (same folder as main.py) and fill in your values.
# Never commit the real .env -- add it to .gitignore.

# ---- master switches -------------------------------------------------------
EMAIL_ENABLED=true
# While developing, set this to true: emails are printed to the terminal
# instead of being sent, so you can test the whole flow with no SMTP account.
EMAIL_CONSOLE_ONLY=true

# ---- SMTP ------------------------------------------------------------------
# Gmail: generate an App Password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification on). Your normal Gmail password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=yourname@gmail.com
SMTP_FROM_NAME=Student Marketplace
SMTP_TIMEOUT=20

# Port 465 instead? Use:
# SMTP_PORT=465
# SMTP_SSL=true
# SMTP_STARTTLS=false

# ---- app -------------------------------------------------------------------
APP_NAME=HyperLocal Student Marketplace
MARKETPLACE_DB=marketplace.db
# Max shops emailed when one student posts a request (fan-out guard)
EMAIL_MAX_FANOUT=50

# Where the browser client is served from. Used to build the link inside a
# password-reset email; leave it empty and the email carries a code to paste
# instead, which works but reads badly.
APP_URL=http://localhost:8080

# ---- accounts and sessions -------------------------------------------------
# Comma-separated addresses allowed to block, unblock and remove accounts.
# Nothing in the API can grant this, so there is no endpoint to find and no
# row to tamper with -- revoking it is editing this line.
ADMIN_EMAILS=

# How long a sign-in survives without being used. The window slides forward on
# every request, so an active user is never signed out; an abandoned phone
# stops working on its own.
SESSION_TTL_DAYS=30

# How long a password-reset link stays valid. Short on purpose: it is a way
# into the account, and it is read minutes after it is asked for.
RESET_TTL_MINUTES=60
